@{
  ViewData["Title"] = "Stop Guessing. Start Deploying.";
}

<!-- Section 1: Hero Container -->
<section class="hero-container py-5">
  <div class="container d-flex flex-wrap align-items-center" style="gap: var(--space-8);">
    
    <!-- Left Hero Copy -->
    <div class="col-lg-6" style="flex: 1; min-width: 320px;">
      <div class="hero-badge">
        <span>✦</span>
        <span>Powered by Roslyn Static Analysis</span>
      </div>
      <h1 class="hero-title">
        Stop Guessing.<br/>
        <span class="hero-title-accent">Start Deploying.</span>
      </h1>
      <p class="hero-subtitle">
        CloudAdvisor reads your ASP.NET Core code and tells you exactly which AWS services you need — with cost estimates, automatically.
      </p>
      
      <div class="hero-ctas">
        <a href="/register" class="btn btn-primary">Get Started Free →</a>
        <a href="/about" class="btn btn-ghost">Watch Demo ▷</a>
      </div>

      <div class="hero-trust">
        <div class="trust-item">
          <span class="trust-icon">✓</span>
          <span>No cloud expertise needed</span>
        </div>
        <div class="trust-item">
          <span class="trust-icon">✓</span>
          <span>Free tier available</span>
        </div>
        <div class="trust-item">
          <span class="trust-icon">✓</span>
          <span>Results in under 30 seconds</span>
        </div>
      </div>
    </div>

    <!-- Right Hero: Animated Node Graph SVG -->
    <div class="col-lg-6 hero-graph" style="flex: 1; min-width: 320px;">
      <svg class="graph-svg" viewBox="0 0 500 400" id="hero-node-graph">
        <!-- Connecting paths -->
        <path d="M100,200 L250,80" class="graph-link" />
        <path d="M100,200 L250,200" class="graph-link" />
        <path d="M100,200 L250,320" class="graph-link" />
        <path d="M250,80 L400,140" class="graph-link" />
        <path d="M250,320 L400,260" class="graph-link" />
        <path d="M250,200 L400,200" class="graph-link" />

        <!-- Node 1: User / Edge (CloudFront) -->
        <g class="graph-node" transform="translate(100, 200)">
          <circle r="36" />
          <text y="4">CDN</text>
        </g>
        <!-- Node 2: App Host (EC2) -->
        <g class="graph-node" transform="translate(250, 80)">
          <circle r="36" />
          <text y="4">EC2</text>
        </g>
        <!-- Node 3: Worker (Lambda) -->
        <g class="graph-node" transform="translate(250, 200)">
          <circle r="36" />
          <text y="4">Lambda</text>
        </g>
        <!-- Node 4: Storage (S3) -->
        <g class="graph-node" transform="translate(250, 320)">
          <circle r="36" />
          <text y="4">S3</text>
        </g>
        <!-- Node 5: Database (RDS) -->
        <g class="graph-node" transform="translate(400, 140)">
          <circle r="36" />
          <text y="4">RDS</text>
        </g>
        <!-- Node 6: User Directory (Cognito) -->
        <g class="graph-node" transform="translate(400, 260)">
          <circle r="36" />
          <text y="4">Cognito</text>
        </g>
      </svg>
    </div>

  </div>
</section>

<!-- Stats Bar -->
<section class="stats-bar">
  <div class="container">
    <div class="row">
      <div class="col-md-3 stat-item">
        <div class="stat-num">500+</div>
        <div class="stat-label">Projects Analysed</div>
      </div>
      <div class="col-md-3 stat-item">
        <div class="stat-num">15+</div>
        <div class="stat-label">AWS Services Mapped</div>
      </div>
      <div class="col-md-3 stat-item">
        <div class="stat-num">&lt; 30s</div>
        <div class="stat-label">Analysis Time</div>
      </div>
      <div class="col-md-3 stat-item">
        <div class="stat-num">100%</div>
        <div class="stat-label">Free to Start</div>
      </div>
    </div>
  </div>
</section>

<!-- Section 2: How It Works -->
<section class="how-it-works">
  <div class="container">
    <div class="section-header">
      <h2 class="section-title">How CloudAdvisor Works</h2>
      <p class="section-desc">Simple. Fast. Smart.</p>
    </div>
    
    <div class="row g-4">
      <div class="col-md-4">
        <div class="step-card">
          <div class="step-pill">01</div>
          <h3 class="step-title">Upload ZIP</h3>
          <p class="step-desc">
            Upload your ASP.NET Core project as a ZIP archive. We accept any standard project structure.
          </p>
        </div>
      </div>
      <div class="col-md-4">
        <div class="step-card">
          <div class="step-pill">02</div>
          <h3 class="step-title">Analyse Code</h3>
          <p class="step-desc">
            Our Roslyn-powered engine scans every C# file, detecting controllers, databases, auth, file handling, and background services.
          </p>
        </div>
      </div>
      <div class="col-md-4">
        <div class="step-card">
          <div class="step-pill">03</div>
          <h3 class="step-title">Deploy Smart</h3>
          <p class="step-desc">
            Receive matched AWS service recommendations with clear explanations and a monthly cost breakdown — no cloud expertise required.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Section 3: Features Showcase -->
<section class="features-section" id="features">
  <div class="container">
    <div class="section-header">
      <h2 class="section-title">Product Showcase</h2>
      <p class="section-desc">Full suite of cloud mapping capabilities.</p>
    </div>

    <!-- Feature 1 -->
    <div class="feature-row">
      <div class="feature-content">
        <h3 class="feature-title">Static Code Analysis — Zero Setup</h3>
        <p class="feature-body">
          CloudAdvisor uses the Microsoft Roslyn compiler to parse your C# source code into an Abstract Syntax Tree. No configuration, no running your app — just upload and go.
        </p>
      </div>
      <div class="feature-visual">
        <div class="mockup-card">
          <div class="code-mockup">
<span class="code-comment">// Scanning syntax tree for DB bindings</span>
<span class="code-keyword">public class</span> <span class="code-type">ProductRepository</span> : <span class="code-type">IRepository</span>
{
  <span class="code-keyword">private readonly</span> <span class="code-type">ApplicationDbContext</span> _context;
  <span class="code-comment">// Result: Amazon RDS (PostgreSQL) Mapped ✓</span>
}</div>
        </div>
      </div>
    </div>

    <!-- Feature 2 -->
    <div class="feature-row">
      <div class="feature-content">
        <h3 class="feature-title">Intelligent AWS Service Mapping</h3>
        <p class="feature-body">
          A transparent rule-based engine maps each detected architectural component to the right AWS service. You see exactly why each service was recommended.
        </p>
      </div>
      <div class="feature-visual">
        <div class="mockup-card">
          <div style="border-left: 3px solid var(--color-accent); padding-left: var(--space-4);">
            <div class="mono" style="font-weight: 700; color: var(--color-accent); font-size: var(--text-sm);">Amazon RDS Recommended</div>
            <p style="font-size: var(--text-xs); color: var(--color-text-secondary); margin-top: var(--space-1);">
              Triggered by: <code>DbContext</code> heritage in <code>Data/ApplicationDbContext.cs</code>.
            </p>
          </div>
        </div>
      </div>
    </div>

    <!-- Feature 3 -->
    <div class="feature-row">
      <div class="feature-content">
        <h3 class="feature-title">Instant Cost Estimation</h3>
        <p class="feature-body">
          Get a monthly cost breakdown for every recommended service before you write a single line of infrastructure code. Plan your cloud budget confidently.
        </p>
      </div>
      <div class="feature-visual">
        <div class="mockup-card" style="text-align: center;">
          <div class="mono" style="font-size: var(--text-xl); font-weight: 800; color: var(--color-accent);">$117.97/mo</div>
          <p style="font-size: var(--text-xs); color: var(--color-text-muted); margin-top: var(--space-1);">Total Estimated Compute & DB Cost</p>
        </div>
      </div>
    </div>

    <!-- Feature 4 -->
    <div class="feature-row">
      <div class="feature-content">
        <h3 class="feature-title">Downloadable PDF Report</h3>
        <p class="feature-body">
          Generate a structured deployment planning report to share with your team, submit for review, or use as your cloud architecture specification.
        </p>
      </div>
      <div class="feature-visual">
        <div class="mockup-card" style="display: flex; gap: var(--space-3); align-items: center;">
          <div style="font-size: var(--text-4xl);">📄</div>
          <div>
            <div class="mono" style="font-weight: 600; font-size: var(--text-sm);">CloudAdvisor_Report_MyWebApp.txt</div>
            <p style="font-size: var(--text-xs); color: var(--color-text-muted);">Text advisory summary mapping</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

