@{
  ViewData["Title"] = "Pricing Manager";
}

<div class="container py-5">
  <div class="admin-layout">
    <!-- Sidebar -->
    <aside class="admin-sidebar">
      <h3 class="admin-sidebar-title">CloudAdvisor Admin</h3>
      <ul class="admin-menu">
        <li><a href="/admin">📊 Overview</a></li>
        <li><a href="/admin/users">👥 Users</a></li>
        <li><a href="/admin/sessions">🔍 All Sessions</a></li>
        <li><a href="/admin/rules">⚙ Rules</a></li>
        <li><a href="/admin/pricing" class="active">💰 Pricing</a></li>
      </ul>
      <div style="margin-top: var(--space-8); padding-top: var(--space-4); border-top: 1px solid var(--color-border);">
        <a href="/dashboard" style="font-size: var(--text-sm); color: var(--color-text-secondary);">← Back to App</a>
      </div>
    </aside>

    <!-- Main Panel -->
    <div class="admin-main">
      <div class="card-title-bar" style="margin-bottom: var(--space-4);">
        <h2>Edit Pricing Configuration</h2>
      </div>
      <p class="text-muted" style="font-size: var(--text-sm); margin-bottom: var(--space-6);">
        Adjust standard monthly cost structures for each AWS service configuration. Cost estimations update immediately on next analysis.
      </p>

      <!-- Pricing Catalog Table -->
      <div class="table-wrapper">
        <table class="custom-table">
          <thead>
            <tr>
              <th>Service</th>
              <th>Tier</th>
              <th>Monthly Cost (USD)</th>
              <th>Unit</th>
              <th>Action</th>
            </tr>
          </thead>
          <tbody id="pricing-table-body">
            <tr>
              <td colspan="5" class="text-center">Loading pricing options...</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

@section Scripts {
  <script src="~/js/admin-pricing.js" asp-append-version="true"></script>
}
