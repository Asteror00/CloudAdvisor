@{
  ViewData["Title"] = "Sign In";
}

<div class="auth-wrapper">
  <div class="auth-card">
    <div class="auth-header">
      <div class="auth-logo-icon">🔑</div>
      <h3 class="auth-card-title">Welcome back</h3>
      <p class="auth-card-subtitle">Log in to your CloudAdvisor account</p>
    </div>

    <!-- Alert banner -->
    <div class="form-alert" id="login-alert-banner" style="display: none;"></div>

    <form id="login-form" method="post">
      <!-- Email Address -->
      <div class="form-group">
        <label for="login-email" class="form-label">Email Address</label>
        <input type="email" id="login-email" name="Email" placeholder="sulav@example.com" class="form-input" required />
      </div>

      <!-- Password -->
      <div class="form-group">
        <div class="d-flex justify-content-between align-items-center mb-2">
          <label for="login-password" class="form-label" style="margin-bottom: 0;">Password</label>
          <a href="#" id="forgot-password-link" style="font-size: var(--text-xs); font-weight: 500; color: var(--color-accent);">Forgot password?</a>
        </div>
        <div class="password-input-wrapper">
          <input type="password" id="login-password" name="Password" placeholder="••••••••" class="form-input" required />
          <span class="password-toggle" id="toggle-password">👁</span>
        </div>
      </div>

      <button type="submit" class="btn btn-primary w-100" style="padding: var(--space-3); font-size: var(--text-sm); margin-top: var(--space-6);">Log In →</button>
    </form>

    <div class="auth-divider" style="text-align: center; margin: var(--space-4) 0; position: relative;">
      <span style="background: var(--surface-2); padding: 0 var(--space-3); color: var(--text-muted); font-size: var(--text-xs); position: relative; z-index: 1;">OR</span>
      <div style="position: absolute; top: 50%; left: 0; right: 0; height: 1px; background: var(--border-color); z-index: 0;"></div>
    </div>

    <!-- Google Sign-In Button Container -->
    <div id="google-signin-button" style="display: flex; justify-content: center; margin-bottom: var(--space-4);"></div>


    <div class="form-footer-link">
      Don't have an account? <a href="/register">Sign up</a>
    </div>
  </div>
</div>

@section Scripts {
  <script src="~/js/login.js" asp-append-version="true"></script>
}
