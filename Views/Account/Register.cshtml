@{
  ViewData["Title"] = "Create Account";
}

<div class="auth-wrapper">
  <div class="auth-card">
    <div class="auth-header">
      <div class="auth-logo-icon">✦</div>
      <h3 class="auth-card-title">Create your account</h3>
      <p class="auth-card-subtitle">Start analysing your projects free</p>
    </div>

    <form id="register-form" method="post">
      <!-- Full Name -->
      <div class="form-group">
        <label for="reg-fullname" class="form-label">Full Name</label>
        <input type="text" id="reg-fullname" name="FullName" placeholder="John Doe" class="form-input" required minlength="2" />
        <span class="form-error" style="display: none;"></span>
      </div>

      <!-- Email Address -->
      <div class="form-group">
        <label for="reg-email" class="form-label">Email Address</label>
        <input type="email" id="reg-email" name="Email" placeholder="sulav@example.com" class="form-input" required />
        <span class="form-error" style="display: none;"></span>
      </div>

      <!-- Password -->
      <div class="form-group">
        <label for="reg-password" class="form-label">Password</label>
        <input type="password" id="reg-password" name="Password" placeholder="••••••••" class="form-input" required minlength="8" />
        
        <!-- Strength Meter -->
        <div class="password-strength-container">
          <div class="password-strength-bar">
            <div class="strength-segment" id="strength-1"></div>
            <div class="strength-segment" id="strength-2"></div>
            <div class="strength-segment" id="strength-3"></div>
            <div class="strength-segment" id="strength-4"></div>
          </div>
          <div class="password-strength-label">Strength: <span id="strength-label">None</span></div>
        </div>
        <span class="form-error" style="display: none;"></span>
      </div>

      <!-- Confirm Password -->
      <div class="form-group" style="position: relative;">
        <div class="d-flex justify-content-between align-items-center mb-2">
          <label for="reg-confirm-password" class="form-label" style="margin-bottom: 0;">Confirm Password</label>
          <span id="confirm-checkmark" style="display: none; font-size: var(--text-xs); font-weight: 600;"></span>
        </div>
        <input type="password" id="reg-confirm-password" placeholder="••••••••" class="form-input" required />
        <span class="form-error" style="display: none;"></span>
      </div>

      <button type="submit" class="btn btn-primary w-100" style="padding: var(--space-3); font-size: var(--text-sm); margin-top: var(--space-4);">Create Account →</button>
    </form>

    <div class="auth-divider" style="text-align: center; margin: var(--space-4) 0; position: relative;">
      <span style="background: var(--surface-2); padding: 0 var(--space-3); color: var(--text-muted); font-size: var(--text-xs); position: relative; z-index: 1;">OR</span>
      <div style="position: absolute; top: 50%; left: 0; right: 0; height: 1px; background: var(--border-color); z-index: 0;"></div>
    </div>

    <!-- Google Sign-In Button Container -->
    <div id="google-signin-button" style="display: flex; justify-content: center; margin-bottom: var(--space-4);"></div>


    <div class="form-footer-link">
      Already have an account? <a href="/login">Log in</a>
    </div>

    <!-- Agreement note -->
    <div style="margin-top: var(--space-6); text-align: center; font-size: 10px; color: var(--color-text-muted); border-top: 1px solid var(--color-border); padding-top: var(--space-4);">
      By creating an account you agree to our Terms of Service & Privacy Policy
    </div>
  </div>
</div>

@section Scripts {
  <script src="~/js/register.js" asp-append-version="true"></script>
}
