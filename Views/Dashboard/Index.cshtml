@{
  ViewData["Title"] = "User Dashboard";
}

<div class="container py-5">
  <!-- Header -->
  <div class="dashboard-header">
    <div>
      <h2 class="dashboard-title" id="welcome-user-text">Welcome back 👋</h2>
      <p class="dashboard-subtitle">Here are your recent project analyses.</p>
    </div>
    <a href="/upload" class="btn btn-primary">+ New Analysis</a>
  </div>

  <!-- Stats Grid -->
  <div class="dashboard-stats">
    <div class="dashboard-stat-card">
      <div class="dashboard-stat-icon bg-accent-subtle">📊</div>
      <div>
        <div class="dashboard-stat-label">Analyses Run</div>
        <div class="dashboard-stat-value" id="stat-analyses">-</div>
      </div>
    </div>
    <div class="dashboard-stat-card">
      <div class="dashboard-stat-icon bg-success-subtle">☁</div>
      <div>
        <div class="dashboard-stat-label">AWS Services</div>
        <div class="dashboard-stat-value" id="stat-services">-</div>
      </div>
    </div>
    <div class="dashboard-stat-card">
      <div class="dashboard-stat-icon bg-info-subtle">💰</div>
      <div>
        <div class="dashboard-stat-label">Avg. Cost/mo</div>
        <div class="dashboard-stat-value" id="stat-cost">-</div>
      </div>
    </div>
    <div class="dashboard-stat-card">
      <div class="dashboard-stat-icon bg-warning-subtle">📄</div>
      <div>
        <div class="dashboard-stat-label">Reports Mapped</div>
        <div class="dashboard-stat-value" id="stat-reports">-</div>
      </div>
    </div>
  </div>

  <!-- Recent Analyses Card Table -->
  <div class="table-wrapper" id="dashboard-table-container">
    <div class="card-title-bar" style="padding: var(--space-4) var(--space-6) 0 var(--space-6);">
      <h3 class="dashboard-card-title">Recent Project Analyses</h3>
    </div>
    <table class="custom-table" style="margin-top: var(--space-4);">
      <thead>
        <tr>
          <th>Project Name</th>
          <th>Date</th>
          <th>Status</th>
          <th>Cost/mo</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody id="dashboard-table-body">
        <!-- Skeleton loading rows generated by JS -->
        <tr><td colspan="5"><div class="skeleton skeleton-line"></div></td></tr>
        <tr><td colspan="5"><div class="skeleton skeleton-line"></div></td></tr>
        <tr><td colspan="5"><div class="skeleton skeleton-line"></div></td></tr>
      </tbody>
    </table>
  </div>

  <!-- Empty State (Hidden by default) -->
  <div id="dashboard-empty-state" style="display: none; padding: var(--space-12) 0; text-align: center; background: var(--color-bg-card); border: 1px solid var(--color-border); border-radius: var(--radius-lg);">
    <div style="font-size: var(--text-4xl); margin-bottom: var(--space-4);">📂</div>
    <h3 style="font-size: var(--text-lg); font-weight: 700; margin-bottom: var(--space-2);">No analyses yet</h3>
    <p class="text-muted" style="font-size: var(--text-sm); margin-bottom: var(--space-6); max-width: 360px; margin-left: auto; margin-right: auto;">
      Upload your first ASP.NET Core project ZIP file to analyze features and match AWS infrastructure configurations.
    </p>
    <a href="/upload" class="btn btn-primary">Upload Your First Project</a>
  </div>
</div>

@section Scripts {
  <script src="~/js/dashboard.js" asp-append-version="true"></script>
}